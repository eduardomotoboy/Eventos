# ==============================================================================
# ARQUIVO: .gitignore
# PROJETO: Eventos (Módulo de Inscrição e Extensão Universitária - UNIFACCAMP)
# DESCRIÇÃO: Ignora arquivos temporários, caches, ambientes virtuais e arquivos de ambiente (.env).
# ==============================================================================

# Arquivo de configuração de ambiente com credenciais confidenciais (fica somente na máquina local)
.env
.env.local
.env.*.local
*.env
!.env_exemplo
!.env.example

# Caches compilados de bytecode do Python
__pycache__/
*.py[cod]
*$py.class

# Ambientes virtuais locais
.venv/
venv/
env/
ENV/

# Arquivos temporários de IDEs
.vscode/
.idea/
*.swp
*.swo

# Banco de dados local residual (utiliza-se MySQL 8.0)
*.db
*.db-journal
scripts_teste/

# Arquivos de projeto enviados pelos alunos (não versionar conteúdo binário)
uploads/