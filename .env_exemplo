# ==============================================================================
# ARQUIVO: .env_exemplo (MODELO DE CONFIGURAÇÃO PARA O INSTALADOR)
# PROJETO: Eventos (Módulo de Inscrição e Extensão Universitária - UNIFACCAMP)
# INSTRUÇÕES:
# 1. Copie este arquivo para um novo arquivo chamado '.env' no mesmo diretório:
#    No Windows PowerShell: cp .env_exemplo .env
#    No Linux/Mac: cp .env_exemplo .env
# 2. Preencha as credenciais do seu banco de dados MySQL e suas configurações de SMTP.
# 3. O arquivo '.env' está incluído no .gitignore e NUNCA será enviado ao Git.
# ==============================================================================

# 1. Configurações de Conexão com o Banco de Dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_usuario_mysql
DB_PASSWORD=sua_senha_mysql
DB_NAME=Eventos

# 2. Chave Institucional Secreta (Pepper) para Blind Index e Hashing de CPF (LGPD)
# Gere uma sequência secreta de caracteres aleatórios para proteger os CPFs
CPF_PEPPER_KEY=chave_secreta_institucional_substitua_aqui_para_producao_@#!*

# 3. Chave Secreta para Sessões HTTP Criptografadas (Starlette SessionMiddleware)
SESSION_SECRET_KEY=chave_secreta_de_sessao_substitua_aqui_2026

# 4. Configuração de Rede e Host do Servidor Uvicorn
APP_HOST=0.0.0.0
APP_PORT=8000

# 5. CPF Padrão Inicial do Administrador/Gestor do Sistema
ADMIN_DEFAULT_CPF=00000000000

# 6. Configurações de Servidor SMTP (Para Envio de E-mails de Recuperação de Senha)
# Exemplo para Gmail / Google Workspace:
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu_email@unifaccamp.edu.br
# SMTP_PASSWORD=sua_senha_de_aplicativo_google
# SMTP_FROM=UNIFACCAMP Eventos <seu_email@unifaccamp.edu.br>
# SMTP_TLS=True
#
# Se os campos abaixo forem deixados em branco, o sistema funcionará em modo
# de simulação/desenvolvimento seguro, gerando o código e registrando no log do servidor.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=UNIFACCAMP Eventos <nao-responda@unifaccamp.edu.br>
SMTP_TLS=True
